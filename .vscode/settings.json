{
    "json.schemas": [
        {
            "url": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
            "fileMatch": [
                "bucket/*.json",
                "deprecated/*.json"
            ]
        }
    ],
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[powershell]": {
        "editor.tabSize": 4
    }
}
