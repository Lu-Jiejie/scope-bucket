{
    "version": "18.25.0",
    "description": "Sync, search and backup shell history",
    "homepage": "https://atuin.sh",
    "license": "MIT",
    "notes": [
        "To enable history search, add the following to your PowerShell profile:",
        "Invoke-Expression (& { (atuin init powershell --disable-up-arrow | Out-String) })"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/atuinsh/atuin/releases/download/v18.25.0/atuin-x86_64-pc-windows-msvc.zip",
            "hash": "31360ba9fedb9de4ec819e9c853a67cb45b7f567ca580e7b80b2505b6fe13619"
        }
    },
    "bin": "atuin.exe",
    "env_set": {
        "ATUIN_HOME": "$persist_dir\\home"
    },
    "pre_install": "& \"$bucketsdir\\$bucket\\lib\\redirect.ps1\" -Setup -Paths \"$env:USERPROFILE\\.config\\atuin => home\", \"$env:USERPROFILE\\.local\\share\\atuin => home\\data\", \"$env:USERPROFILE\\.atuin => home\"",
    "pre_uninstall": "& \"$bucketsdir\\$bucket\\lib\\redirect.ps1\" -Teardown",
    "checkver": {
        "github": "https://github.com/atuinsh/atuin"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/atuinsh/atuin/releases/download/v$version/atuin-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
