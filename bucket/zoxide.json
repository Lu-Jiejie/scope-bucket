{
    "version": "0.10.0",
    "description": "A faster way to navigate your filesystem",
    "homepage": "https://github.com/ajeetdsouza/zoxide",
    "license": "MIT",
    "notes": [
        "To enable 'z', add the following to your PowerShell profile:",
        "Invoke-Expression (& { (zoxide init powershell | Out-String) })"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ajeetdsouza/zoxide/releases/download/v0.10.0/zoxide-0.10.0-x86_64-pc-windows-msvc.zip",
            "hash": "f465ae548f8754c8e7edbc60b45fbf58c92bfe123db83d790252d6810fa5daf1"
        },
        "arm64": {
            "url": "https://github.com/ajeetdsouza/zoxide/releases/download/v0.10.0/zoxide-0.10.0-aarch64-pc-windows-msvc.zip",
            "hash": "b0e6eb62b11ebf168d5c65c5d23c635e81848cc4a88ae6b9caee64cf1e35d12b"
        }
    },
    "bin": "zoxide.exe",
    "env_set": {
        "_ZO_DATA_DIR": "$persist_dir\\data"
    },
    "pre_install": [
        "& \"$bucketsdir\\$bucket\\lib\\redirect.ps1\" -Setup -Paths \"$env:LOCALAPPDATA\\zoxide => data\""
    ],
    "pre_uninstall": [
        "& \"$bucketsdir\\$bucket\\lib\\redirect.ps1\" -Teardown"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ajeetdsouza/zoxide/releases/download/v$version/zoxide-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/ajeetdsouza/zoxide/releases/download/v$version/zoxide-$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
